  </asset>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
    </default>
    <!-- 팔 링크는 일반 메시 충돌을 사용한다. 이 단계에서는 자체 충돌 정밀도가 핵심이 아니다. -->
    <default class="arm_collision">
      <geom type="mesh" group="3"/>
    </default>
    <!-- 손 충돌은 1·2단계의 models/hand_only.xml과 같은 shadow_hand 설정을 사용한다. -->
    <default class="collision">
      <geom group="3" contype="1" conaffinity="1" condim="3" solimp="0.5 0.99 0.0001" solref="0.005 1"/>
    </default>

    <!-- DY-80 모터: 팔 1·2번 관절 -->
    <default class="DY_80">
      <joint frictionloss="0.1" armature="0.5" damping="30.0"/>
      <position kp="600" dampratio="1" forcerange="-61.4 61.4"/>
      <default class="arm_r_joint1">
        <joint axis="0 1 0" range="-3.14 3.14"/>
      </default>
      <default class="arm_r_joint2">
        <joint axis="1 0 0" range="-3.14 0"/>
      </default>
    </default>
    <!-- DY-70 모터: 팔 3~6번 관절 -->
    <default class="DY_70">
      <joint frictionloss="0.1" armature="0.5" damping="20.0"/>
      <position kp="600" dampratio="1" forcerange="-31.7 31.7"/>
      <default class="arm_r_joint3">
        <joint axis="0 0 1" range="-3.14 3.14"/>
      </default>
      <default class="arm_r_joint4">
        <joint axis="0 1 0" range="-2.9361 1.0786"/>
      </default>
      <default class="arm_r_joint5">
        <joint axis="0 0 1" range="-3.14 3.14"/>
      </default>
      <default class="arm_r_joint6">
        <joint axis="0 1 0" range="-1.57 1.57"/>
      </default>
    </default>
    <!-- DP-42 모터: 팔 7번 관절 -->
    <default class="DP_42">
      <joint frictionloss="0.1" armature="0.1" damping="3.0"/>
      <position kp="200" dampratio="1" forcerange="-5.1 5.1"/>
      <default class="arm_r_joint7">
        <joint axis="1 0 0" range="-1.5804 1.8201"/>
      </default>
    </default>

    <!-- HX5-D20 오지형 손: models/hand_only.xml과 동일하다. -->
    <default class="finger">
      <joint frictionloss="0.05" armature="0.05" damping="1.0"/>
      <position kp="0.7" dampratio="1" forcerange="-1.0 1.0"/>
      <default class="thumb_r_cmc">
        <joint axis="1 0 0" range="-1.5708 1.5708"/>
      </default>
      <default class="thumb_r_mcp_yaw">
        <joint axis="0 0 1" range="-3.1416 0"/>
      </default>
      <default class="thumb_r_mcp_pitch">
        <joint axis="1 0 0" range="0 1.5708"/>
      </default>
      <default class="thumb_r_ip">
        <joint axis="1 0 0" range="0 1.5708"/>
      </default>
      <default class="finger_mcp">
        <joint axis="1 0 0" range="-0.6109 0.6109"/>
      </default>
      <default class="finger_pip">
        <joint axis="0 1 0" range="0 2.0071"/>
      </default>
      <default class="finger_dip">
        <joint axis="0 1 0" range="0 1.5708"/>
      </default>
      <default class="finger_tip">
        <joint axis="0 1 0" range="0 1.5708"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 2.2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 테이블 윗면의 높이는 z=0.65다. -->
    <!-- 팔을 향하는 X축 방향 폭을 좁혔다. 1·2단계에서 검증한 파지 형상은 가까운 쪽의
         손바닥이 손끝과 캔보다 낮아져야 한다. 이 손 방향에서는 손바닥이 파지점 뒤에 놓이므로
         폭이 넓은 테이블에서는 손을 내릴 때마다 충돌했다. 다만 Y축 폭과 캔 아래 깊이는
         실제 테이블처럼 보이고 동작할 만큼 유지했다. -->
    <geom name="table" type="box" size="0.08 0.15 0.05" pos="0.5 0.0 0.60" material="table_mat"/>

    <!-- 캔은 자유 관절로 테이블 위에 놓인다. 초기 높이와 관계없이 테이블 윗면과 캔의
         반높이를 더한 0.705에 안착하므로 여기서 띄워 배치하는 방식은 통하지 않는다.
         테이블 여유 높이는 tests/test_phase_3.py의 GRASP_TARGET_OFFSET으로 보정하며,
         실제 안착 중심보다 3 cm 높은 곳을 IK 목표로 삼는다. -->
    <body name="can" pos="0.5 0.0 0.705">
      <freejoint name="can_free"/>
      <inertial pos="0 0 0" mass="0.35" diaginertia="0.000448 0.000448 0.00019"/>
      <geom name="can_geom" type="cylinder" size="0.033 0.055" material="can_mat"
        priority="1" condim="6" friction="0.5 0.01 0.003"
        solimp="0.5 0.99 0.0001" solref="0.005 1"/>
    </body>

